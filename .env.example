# Copy to ".env" for local dev. On Render, set these under Environment instead.
# These are SERVER-SIDE secrets — never prefix with VITE_ and never commit real values.

# Your Deskworks Satellite API key. NOTE: must be WRITE-scoped to auto-create
# reservations (a read-only catalog token can read availability but 404s on POST).
DESKWORKS_API_KEY=

# Base URL of your Deskworks site, e.g. https://jvo.satellitedeskworks.com
DESKWORKS_BASE_URL=
# Deskworks center + reservation-unit IDs (JVO outdoor space = center 6, unit 32)
DESKWORKS_CENTER_ID=6
DESKWORKS_UNIT_ID=32
# Auto-create reservations in Deskworks. OFF until Deskworks issues a
# write-scoped token + the real create endpoint (the catalog token can only
# READ). Leave blank/false to run calendar-only; set to true once the write
# token is in DESKWORKS_API_KEY and the endpoint is confirmed.
DESKWORKS_WRITE_ENABLED=false
# (optional) Override the create-reservation endpoint path once confirmed, and
# the default local start hour (24h) for the booking block.
# DESKWORKS_CREATE_PATH=/api/v1/centers/6/reservations
# DESKWORKS_DEFAULT_START_HOUR=10
# Weekdays (0=Sun..6=Sat) to NOT block from Deskworks unavailability. Set to 6 so
# Deskworks' manual-only Saturday rule doesn't hide every Saturday on the site.
DESKWORKS_IGNORE_WEEKDAYS=6

# Port the Express server listens on (Render sets this automatically in prod)
PORT=8787

# --- Google Calendar availability (blocks already-booked dates) ---
# Calendar ID of the JVO booking calendar (Calendar Settings → "Integrate
# calendar" → Calendar ID). Often an @group.calendar.google.com id or a gmail.
GOOGLE_CALENDAR_ID=
# The FULL service-account JSON key, on a single line. Create it in Google Cloud
# Console (Calendar API enabled), then share the calendar with the service
# account's email as "Make changes to events" (needed so the site can create
# booking holds, not just read). NEVER an account password.
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- JotForm booking webhook (auto-books on form submission) ---
# Shared secret appended to the webhook URL (?token=...) so only JotForm can
# trigger a booking. Pick a long random string and set the same value in the
# JotForm webhook URL: https://jvoevents.com/api/jotform-hook?token=<secret>
JOTFORM_WEBHOOK_SECRET=
# JotForm API key — used to map form field IDs (and fetch submissions). From
# JotForm → Account → API.
JOTFORM_API_KEY=
# (optional) The booking form id, and an explicit field map if the heuristic
# mapping needs pinning, e.g. {"eventDate":"q5_eventDate","name":"q3_name"}.
# JOTFORM_FORM_ID=222155218269153
# JOTFORM_FIELD_MAP=

# --- Booking confirmation email (SMTP) ---
# Sent automatically after a booking is recorded (deposit received). If these
# are blank, the email is simply skipped — bookings still work.
# For Gmail: enable 2-Step Verification, then create an App Password
# (Google Account → Security → App passwords) and use that as SMTP_PASS.
SMTP_USER=jonesborovirtualoffice@gmail.com
SMTP_PASS=
# (optional) Defaults below are used if unset.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# MAIL_FROM=JVO Events <jonesborovirtualoffice@gmail.com>
# MAIL_REPLY_TO=jonesborovirtualoffice@gmail.com

# --- 30-day payment reminder sweep ---
# Emails guests ~30 days before their event if their full balance isn't paid,
# warning that within 14 days the deposit is non-refundable. Payment status is
# read from Deskworks (server/deskworksPayments.js — still a STUB until the
# Deskworks invoice API key/endpoint exist), so reminders only send once that's
# wired AND this flag is "true". While "false" the sweep just logs a dry run.
PAYMENT_REMINDERS_ENABLED=false
# (optional) Send reminders even when Deskworks can't confirm payment yet
# (treats "unknown" as unpaid). Leave false to avoid emailing paid guests.
# PAYMENT_REMINDER_ASSUME_UNPAID=false
# (optional) Days before the event to remind (default 30) and the daily run time
# (5-field cron, default 9am in EVENT_TIMEZONE).
# PAYMENT_REMINDER_DAYS=30
# PAYMENT_REMINDER_CRON=0 9 * * *
# (optional) Secret to protect POST /api/cron/payment-reminders. Falls back to
# JOTFORM_WEBHOOK_SECRET if unset.
# CRON_SECRET=

# --- Book a Tour (timed calendar appointments) ---
# The "Book a Tour" page posts to /api/book-tour, which drops a 30-minute timed
# appointment on the Google Calendar above (marked "free" so it doesn't block the
# whole date for event bookings) and emails the guest + jonesborovirtualoffice.
# Tours run Mon–Fri, 9:00 AM–5:00 PM in the timezone below. Requires the same
# GOOGLE_CALENDAR_ID + GOOGLE_SERVICE_ACCOUNT_JSON as event bookings.
# (optional) Tour length in minutes; defaults to 30.
# TOUR_DURATION_MIN=30

# (optional) Timezone used for Deskworks reservation start/end datetimes, tour
# appointment times, and for the payment-reminder day math / daily schedule.
# EVENT_TIMEZONE=America/New_York

# Which space bookings are for — shown on the calendar event + Deskworks payload.
# This site books the Outdoor Event Center; change only if it serves another space.
DEFAULT_SPACE=Outdoor Event Center

# --- Daily news agent (private /news dashboard) ---
# Every morning the server gathers a briefing across three tracks — U.S. politics
# & the presidency, world & war, and AI/tech — from free public news feeds and
# serves it at /news. Works with NO configuration (raw headlines). Optionally,
# set an Anthropic API key below to have Claude curate the top stories and write
# a short "why it matters" note for each — useful for the AI-consulting track.
# Get a key at https://console.anthropic.com. If unset, the page still works.
ANTHROPIC_API_KEY=
# (optional) Model used for curation. Defaults to a cost-effective model.
# NEWS_AI_MODEL=claude-haiku-4-5-20251001
# (optional) Daily build time (5-field cron, in EVENT_TIMEZONE). Default 6am.
# NEWS_CRON=0 6 * * *
# (optional) How many headlines to keep per track. Default 7.
# NEWS_ITEMS_PER_TRACK=7
# The manual refresh endpoint POST /api/cron/news-refresh reuses CRON_SECRET
# (which falls back to JOTFORM_WEBHOOK_SECRET) for auth.
